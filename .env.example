# Required.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_IDS=123456789012345678

# Backup schedule
BACKUP_CRON=0 3 * * *
BACKUP_TIMEZONE=America/Chicago
BACKUP_ON_START=true

# Storage
BACKUP_ROOT=/data/backups
BACKUP_RETENTION_DAYS=90
BACKUP_MINIMUM_KEEP=14
BACKUP_PRETTY_JSON=true
BACKUP_IMAGES=base64
BACKUP_MAX_MESSAGES_PER_CHANNEL=0

# Optional exclusions
BACKUP_EXCLUDE_BANS=false
BACKUP_EXCLUDE_EMOJIS=false
BACKUP_EXCLUDE_ROLES=false
BACKUP_EXCLUDE_CHANNELS=false

# Runtime
LOG_LEVEL=info
HEALTH_STATUS_FILE=/data/status/health.json
LOCK_TIMEOUT_SECONDS=3600
HEALTH_GRACE_SECONDS=93600
